media/
staticfiles/

# Local databases (SQLite)
*.sqlite3

# Environment variables and secrets
.env
.env.*
secrets.json
*.pem
*.key

# IDEs and OS metadata
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
.DS_Store
Thumbs.db
