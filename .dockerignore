# Git
.git
.gitignore

# Python bytecode and cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/

# Local virtual environments
venv/
.venv/
env/
ENV/

# Django media files and local statics
